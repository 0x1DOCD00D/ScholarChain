infra/terraform/*_override.tf.json

# Secrets — never committed
.env
.env.*
secrets/
*.pem
*.key
credentials

# Claude Code agent marker
.claude/.last-test-run

# macOS
.DS_Store

# Python cache (hooks)
__pycache__/
*.pyc
